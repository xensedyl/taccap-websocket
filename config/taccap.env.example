# Copy this file to config/taccap.env on a target device.
# The service is reachable directly on the target device's LAN address.

TACCAP_BIND_HOST=0.0.0.0
TACCAP_PORT=8765
TACCAP_FFMPEG=/usr/bin/ffmpeg
TACCAP_LOG_DIR=.log

# deploy.sh writes the bundled virtualenv path here automatically.
TACCAP_PYTHON=
TACCAP_PYTHON_HOME=.runtime/python

# The offline release includes xensesdk and xense.taccap in .venv.  Leave these
# empty; the installer must use only the verified contents of the bundle.
# Do not point them at an SDK or Python installation from another device.
TACCAP_ENV_SCRIPT=
TACCAP_PYTHONPATH=
TACCAP_LD_LIBRARY_PATH=

# Optional explicit device mapping. Auto-discovery is used when unset.
# TACCAP_DEVICE_CONFIG=config/devices.json

# Optional runtime tuning.
TACCAP_CAMERA_JPEG_QUALITY=85

# Gripper command mode.  Both modes use the current SDK's safe ControlLoop;
# the mode selects its gains, not a removed raw Motor Python method. Set
# globally or override one side independently:
#   position = conservative bounded impedance gains
#   mit      = configured MIT impedance gains below
TACCAP_GRIPPER_CONTROL_MODE=position
TACCAP_LEFT_GRIPPER_CONTROL_MODE=
TACCAP_RIGHT_GRIPPER_CONTROL_MODE=
TACCAP_POSITION_KP=8.0
TACCAP_POSITION_KD=1.0
TACCAP_MIT_KP=8.0
TACCAP_MIT_KD=1.0
TACCAP_MIT_FEEDFORWARD_TORQUE=0.0
# Optional host-side target slew limit.  0 disables it; Web调参 can override
# it per service runtime without editing this file.
TACCAP_TARGET_MAX_VELOCITY_RAD_S=0.60
# Independent magnitude limit for the automatic kd*target-speed feed-forward.
# This is not the signed TACCAP_MIT_FEEDFORWARD_TORQUE base bias.
TACCAP_SPEED_FEEDFORWARD_LIMIT_NM=2.0
