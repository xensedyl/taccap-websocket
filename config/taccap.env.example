# Copy this file to config/taccap.env on a target device.
# The service is reachable directly on the target device's LAN address.

TACCAP_BIND_HOST=0.0.0.0
TACCAP_PORT=8765
TACCAP_FFMPEG=/usr/bin/ffmpeg
TACCAP_LOG_DIR=.log

# Leave empty to use the target system Python. If install.sh --with-deps
# is used, it writes the project virtualenv path here automatically.
TACCAP_PYTHON=

# Optional shell file that exports SDK-specific PATH, PYTHONPATH or
# LD_LIBRARY_PATH values before Python starts.
TACCAP_ENV_SCRIPT=

# Optional explicit device mapping. Auto-discovery is used when unset.
# TACCAP_DEVICE_CONFIG=config/devices.json

# Optional runtime tuning.
TACCAP_CAMERA_JPEG_QUALITY=85
